{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsestream.dev/contracts/raw/v1.schema.json",
  "title": "PulseStream raw event v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "eventType": {
      "const": "telemetry.reading"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "deviceType": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "deviceId",
        "deviceType",
        "metric",
        "value",
        "unit",
        "location"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "eventId",
    "tenantId",
    "eventType",
    "timestamp",
    "source",
    "version",
    "payload"
  ],
  "additionalProperties": true
}
